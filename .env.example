PORT=3000

# --- AI sağlayıcısı (birini doldurman yeterli; ikisi de boşsa yerel analiz çalışır) ---
# Ücretsiz Google Gemini anahtarı: aistudio.google.com → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ana model yoğunsa veya kotası dolduysa denenecek yedek model ("none" yazarsan kapalı)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Ücretli alternatif:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Paylaşım ayarları ---
# Doluysa uygulama açılırken bu şifreyi sorar. Arkadaşlarınla paylaşacağın şifreyi yaz.
ACCESS_CODE=
# Kişi başı günlük AI analiz hakkı (0 = sınırsız)
DAILY_AI_LIMIT_PER_USER=15
# Herkes için toplam günlük AI analiz sınırı (Gemini ücretsiz kotasını aşmamak için)
DAILY_AI_LIMIT_TOTAL=200
# Dakikada en fazla kaç AI isteği gönderilsin (Gemini Flash-Lite ücretsiz sınırı dakikada 10)
AI_REQUESTS_PER_MINUTE=8
